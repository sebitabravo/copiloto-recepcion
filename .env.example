# Copia a .env con `make env` (genera secretos). Nunca commitees .env.
POSTGRES_PASSWORD=__GENERATE__
SECRET_KEY_BASE=__GENERATE__
# Secreto compartido entre Chatwoot (outgoing_url del AgentBot) y copiloto
WEBHOOK_SECRET=__GENERATE__
# Secreto con que el PMS simulado avisa reservas confirmadas al copiloto (header, no URL)
PMS_EVENTS_SECRET=__GENERATE__
# Sal secreta para seudonimizar identificadores al vencer la retención (distinta de los demás secretos)
PSEUDONYM_SALT=__GENERATE__
# Token del panel de Chatwoot (Dashboard App) para leer datos de la conversación
PANEL_TOKEN=__GENERATE__
# Token que usa recepción para confirmar en el PMS simulado
STAFF_TOKEN=__GENERATE__
# Contraseña de los usuarios demo de Chatwoot (admin y agentes)
DEMO_PASSWORD=Demo-__GENERATE__!

# Turno humano de recepción (hora local America/Santiago)
SHIFT_START=08:00
SHIFT_END=22:00
# Pruebas reproducibles del horario: open (en turno) o closed (fuera de turno). Vacío = según la hora real.
SHIFT_OVERRIDE=
# /demo corre el flujo guiado con la Hostería Demo Villarrica (ficticia). 1 = usar el asistente con IA.
DEMO_AI=0
# Costo fijo mensual de referencia para el costo por consulta (EVA2: 90.000 CLP)
FIXED_MONTHLY_CLP=90000

# IA conversacional (opcional). Sin API key el asistente funciona con el flujo guiado, sin IA.
# Pega aquí tu API key de DeepSeek (https://platform.deepseek.com). Nunca la commitees.
LLM_API_KEY=
# assisted: la IA conversa, consulta y deriva; recepción confirma (coherente con EVA2) · off: sin IA
# full: la IA también crea la reserva en el PMS simulado (solo demostración técnica)
AI_MODE=assisted
# Muestreo del turno: temperatura y top_p. Con un modelo local conviene dejarlos así (ver docs/ia.md).
# LLM_TEMPERATURE=0.3
# LLM_TOP_P=
# Topes de una llamada al modelo y de un turno completo. El perfil de IA local en Docker los sube.
# LLM_TIMEOUT_S=25
# AI_TURN_TIMEOUT_S=12

# Conector del PMS. Valores por defecto: pms-mock del stack.
# PMS_ADAPTER=http        # "none" deja al hotel sin PMS: orienta y deriva, nunca promete cupos
# PMS_URL=http://pms-mock:8200
# PMS_AVAILABILITY_PATH=/api/v1/availability
# PMS_BOOKING_PATH=/api/v1/bookings
# PMS_AUTH_HEADER=X-Staff-Token
# PMS_TIMEOUT_S=4

# URL pública del copiloto (aviso de privacidad). Mientras sea localhost, el saludo de WhatsApp no incluye el enlace
# porque el teléfono del huésped no lo puede abrir. Con un dominio HTTPS real, el enlace se incluye.
# COPILOTO_PUBLIC_URL=https://copiloto.tu-hotel.cl

# URL pública de la portada, sin barra final: canónicos, Open Graph, JSON-LD, robots.txt y sitemap.xml.
# Nginx la aplica al arrancar el contenedor landing (ver docs/seo.md). Por defecto http://localhost:8080
# PUBLIC_SITE_URL=https://copiloto.tu-hotel.cl
# URLs públicas de la bandeja y del PMS simulado para los enlaces de la portada (las escribe el seed en config.js)
# CHATWOOT_PUBLIC_URL=http://localhost:3000
# PMS_PUBLIC_URL=http://localhost:8200

# Demo de voz (opcional, de pago por uso). Sin clave y sin voz, la demo sigue solo con texto.
# Elige en tu cuenta de ElevenLabs una voz en español y pega su ID. Ver docs/voz.md
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Voz para inglés (opcional): una voz en inglés suena mejor que una chilena hablando inglés
ELEVENLABS_VOICE_ID_EN=

# Notas de voz del WhatsApp: transcripción local (Whisper, MIT). 1 = activada. Ver docs/consentimiento-y-retencion.md
VOICE_NOTES=0
# Tamaño del modelo Whisper: tiny, base o small (por defecto). Más grande = más preciso y más lento en CPU
WHISPER_MODEL=small
# Respaldo de voz local con Piper (MIT en piper-tts 1.2.0). Vacío = desactivado. Ver docs/voz.md
PIPER_MODEL_PATH=
PIPER_CONFIG_PATH=

