# Copia a .env con `make env` (genera secretos). Nunca commitees .env.
POSTGRES_PASSWORD=__GENERATE__
SECRET_KEY_BASE=__GENERATE__
# Secreto compartido entre Chatwoot (outgoing_url del AgentBot) y copiloto
WEBHOOK_SECRET=__GENERATE__
# Secreto con que el PMS simulado avisa reservas confirmadas al copiloto (header, no URL)
PMS_EVENTS_SECRET=__GENERATE__
# Sal secreta para seudonimizar identificadores al vencer la retención (distinta de los demás secretos)
PSEUDONYM_SALT=__GENERATE__
# Token del panel de Chatwoot (Dashboard App) para leer datos de la conversación
PANEL_TOKEN=__GENERATE__
# Token que usa recepción para confirmar en el PMS simulado
STAFF_TOKEN=__GENERATE__
# Contraseña de los usuarios demo de Chatwoot (admin y agentes)
DEMO_PASSWORD=Demo-__GENERATE__!

# Turno humano de recepción (hora local America/Santiago)
SHIFT_START=08:00
SHIFT_END=22:00
# Costo fijo mensual de referencia para el costo por consulta (EVA2: 90.000 CLP)
FIXED_MONTHLY_CLP=90000

# IA conversacional (opcional). Sin API key el asistente funciona con el flujo guiado, sin IA.
# Pega aquí tu API key de DeepSeek (https://platform.deepseek.com). Nunca la commitees.
LLM_API_KEY=
# full: la IA también crea la reserva en el PMS simulado (demo) · assisted: la IA no reserva · off: sin IA
AI_MODE=full

# Conector del PMS (ver docs/conector-pms.md). Valores por defecto: pms-mock del stack.
# PMS_ADAPTER=http        # "none" deja al hotel sin PMS: orienta y deriva, nunca promete cupos
# PMS_URL=http://pms-mock:8200
# PMS_AVAILABILITY_PATH=/api/v1/availability
# PMS_BOOKING_PATH=/api/v1/bookings
# PMS_AUTH_HEADER=X-Staff-Token
# PMS_TIMEOUT_S=4
